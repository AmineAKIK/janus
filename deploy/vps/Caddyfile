{
    auto_https off
    admin off
    servers {
        # nginx (sur la machine) est le seul devant Caddy et pose le vrai `X-Forwarded-For` :
        # sans cela Caddy le remplace par l'adresse du pont Docker, et l'API verrait la même
        # adresse pour tout le monde (limite de débit et essais de connexion partagés).
        trusted_proxies static private_ranges
    }
}

http://janus.akiksystems.fr:8080 {
    encode gzip
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://fiches.janus.akiksystems.fr; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy same-origin
        -Server
    }
    handle /api/* {
        reverse_proxy api:3000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        root * /srv/app
        @empreinte path /assets/*
        header @empreinte Cache-Control "public, max-age=31536000, immutable"
        @jamais not path /assets/*
        header @jamais Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

http://fiches.janus.akiksystems.fr:8080 {
    encode gzip
    header {
        Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: 'self'; font-src data:; media-src data: 'self'; connect-src 'none'; frame-ancestors https://janus.akiksystems.fr"
        X-Content-Type-Options nosniff
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "public, max-age=31536000, immutable"
        -Server
    }
    root * /fiches
    file_server
}
