# Modele de /etc/janus/janus.env (root, mode 0600). Aucune valeur reelle dans le depot.
POSTGRES_PASSWORD=
JANUS_APP_MOT_DE_PASSE=
# Le correcteur : claude (defaut, le tuteur principal) ou deepseek (le secours : l'appli le dit).
# La cle Anthropic est requise ; la cle DeepSeek ne sert qu'au secours. Sans la cle du correcteur
# choisi, l'API refuse de demarrer.
CORRECTEUR=claude
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:adresse@exemple.fr

# Facultatif : suivi d'erreurs (API et front). L'origine est celle du DSN, sans chemin.
SENTRY_DSN=
SENTRY_ORIGINE=
