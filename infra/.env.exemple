# Copier en `.env` (jamais dans git) et remplir. Les mots de passe sont insérés dans des adresses :
# n'utiliser que des lettres et des chiffres, par exemple `openssl rand -hex 24`.

# Le domaine : l'appli est sur app.<DOMAINE>, les fiches sur fiches.<DOMAINE>.
DOMAINE=exemple.fr

# Le rôle propriétaire de la base (migrations, suppression de compte).
POSTGRES_PASSWORD=
# Le rôle de l'API (pas de UPDATE ni DELETE sur les faits). Posé sur la base au démarrage.
JANUS_APP_MOT_DE_PASSE=

# La clé du correcteur IA.
DEEPSEEK_API_KEY=

# Les clés des notifications (voir infra/LISEZMOI.md pour les générer) et un contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:vous@exemple.fr

# Les sauvegardes de la base, chaque nuit, chiffrées par restic vers un stockage objet compatible S3
# (exemple : s3:https://s3.eu-west-1.amazonaws.com/mon-seau/janus). Le mot de passe restic chiffre
# les sauvegardes : le perdre les rend illisibles, le garder ailleurs que sur le serveur.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Le suivi d'erreurs, facultatif (Sentry gratuit ou GlitchTip auto-hébergé). SENTRY_DSN est l'adresse
# donnée par le service ; SENTRY_ORIGINE est son origine (https://erreurs.exemple.fr), autorisée dans
# la politique de sécurité du front. Vides, aucune erreur n'est envoyée.
SENTRY_DSN=
SENTRY_ORIGINE=
