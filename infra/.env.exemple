# Copier en `.env` (jamais dans git) et remplir. Les mots de passe sont insérés dans des adresses :
# n'utiliser que des lettres et des chiffres, par exemple `openssl rand -hex 24`.

# Le domaine : l'appli est sur app.<DOMAINE>, les fiches sur fiches.<DOMAINE>.
DOMAINE=exemple.fr

# Le rôle propriétaire de la base (migrations, suppression de compte).
POSTGRES_PASSWORD=
# Le rôle de l'API (pas de UPDATE ni DELETE sur les faits). Posé sur la base au démarrage.
JANUS_APP_MOT_DE_PASSE=

# La clé du correcteur IA.
DEEPSEEK_API_KEY=

# Les clés des notifications (voir infra/LISEZMOI.md pour les générer) et un contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:vous@exemple.fr
