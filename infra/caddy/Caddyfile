# `DOMAINE` vient de l'environnement : jamais de domaine en dur.
{
	servers {
		protocols h1 h2
	}
}

(compression) {
	encode zstd gzip
}

app.{$DOMAINE} {
	import compression

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$SENTRY_ORIGINE:}; frame-src https://fiches.{$DOMAINE}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/app
		# Fichiers à empreinte : un an. Le reste (index.html, service worker, manifeste) : jamais.
		@empreinte path /assets/*
		header @empreinte Cache-Control "public, max-age=31536000, immutable"
		@jamais not path /assets/*
		header @jamais Cache-Control "no-cache"
		# Historique par chemins : toute adresse inconnue rend l'appli.
		try_files {path} /index.html
		file_server
	}
}

fiches.{$DOMAINE} {
	import compression

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: 'self'; font-src data:; media-src data: 'self'; connect-src 'none'; frame-ancestors https://app.{$DOMAINE}"
		X-Content-Type-Options nosniff
		Cache-Control "public, max-age=31536000, immutable"
		-Server
	}

	root * /fiches
	file_server
}
